{
  "name": "yinian-muyu",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "lint": "eslint . --max-warnings 0",
    "preview": "vite preview --host 127.0.0.1",
    "standalone": "npm run build && node scripts/standalone.mjs",
    "mac": "bash native/build.sh",
    "windows": "npm run build && npm --prefix windows run package",
    "windows:test": "npm --prefix windows test",
    "windows:verify": "npm --prefix windows run verify"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.0",
    "globals": "^16.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.2.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/heshuhuan6/yinian-muyu.git"
  }
}
